# Fonts are content-hashed by name and never change in place, so they can be held for a
# year. The HTML must not be: the whole point of a permanent QR is that what it points at
# can change between markets.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
